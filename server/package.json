{
  "name": "app-backend",
  "description": "Backend",
  "scripts": {
    "start": "nodemon --watch \"src/**/*.ts\" -e ts,json --exec \"ts-node --transpile-only ./src/server.ts\"",
    "test": "nodemon --exec \"cross-env NODE_ENV=test mocha -r ts-node/register ./src/**/*.test.ts --exit || exit 1\"",
    "build:documentation": "copyfiles --flat ./src/documentation/openapi.json ./dist/documentation/",
    "build": "tsc && npm run build:documentation",
    "db:create": "npm run build && node ./dist/database/migrations/create",
    "back": "npx ts-node src/database/utils/stackingWorker.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "5.3.0",
    "@sendgrid/mail": "7.2.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "aws-sdk": "2.756.0",
    "axios": "^1.7.3",
    "bcrypt": "5.0.0",
    "bullmq": "^4.12.0",
    "cli-highlight": "2.1.4",
    "cors": "2.8.5",
    "dotenv": "8.2.0",
    "ethers": "^6.16.0",
    "express": "^4.17.1",
    "express-rate-limit": "5.1.3",
    "fast-xml-parser": "^4.4.1",
    "formidable-serverless": "1.0.3",
    "helmet": "4.1.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^8.5.1",
    "lodash": "4.17.20",
    "moment": "2.28.0",
    "mongoose": "5.10.6",
    "mv": "2.1.1",
    "node-cron": "^4.2.1",
    "passport": "0.4.1",
    "passport-facebook": "3.0.0",
    "passport-google-oauth": "2.0.0",
    "redis": "^5.8.3",
    "sib-api-v3-sdk": "^8.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "8.96.0",
    "swagger-ui-dist": "3.44.1",
    "uuid": "^8.3.2"
  },
  "private": true,
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/redis": "^4.0.10",
    "copyfiles": "2.3.0",
    "cross-env": "7.0.2",
    "html-loader": "^2.1.2",
    "mocha": "8.1.3",
    "node-mocks-http": "1.9.0",
    "nodemon": "2.0.4",
    "ts-node": "9.0.0",
    "typescript": "4.0.3"
  }
}
